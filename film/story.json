  "narration": {
    "scriptA": [
      {
        "id": "V1",
        "text": "义兴三害：山中邅迹虎，水中恶蛟，还有周处。",
        "node": "three-threats",
        "scene_ids": [
          "S01",
          "S02",
          "S03",
          "S04"
        ]
      },
      {
        "id": "V2",
        "text": "乡人劝周处除虎斩蛟，暗盼三害只余其一。",
        "node": "provocation",
        "scene_ids": [
          "S05"
        ]
      },
      {
        "id": "V3",
        "text": "他刺虎，追蛟数十里，三日三夜未归。",
        "node": "battle",
        "scene_ids": [
          "S06",
          "S07",
          "S08"
        ]
      },
      {
        "id": "V4",
        "text": "乡人以为他死了，竟相庆贺。",
        "node": "celebration",
        "scene_ids": [
          "S09"
        ]
      },
      {
        "id": "V5",
        "text": "周处斩蛟归来，才知自己为人所患，决意改过。",
        "node": "realization",
        "scene_ids": [
          "S10"
        ]
      },
      {
        "id": "V6",
        "text": "他寻二陆，只见陆云，忧年已蹉跎。",
        "node": "counsel",
        "scene_ids": [
          "S11"
        ]
      },
      {
        "id": "V7",
        "text": "陆云说：人患志之不立，何忧令名不彰！",
        "node": "counsel",
        "scene_ids": [
          "S11"
        ]
      },
      {
        "id": "V8",
        "text": "周处遂改励，终为忠臣孝子。",
        "node": "reform",
        "scene_ids": [
          "S12"
        ]
      }
    ],
